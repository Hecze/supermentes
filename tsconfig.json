{
  // Solo para lo que corre en Vercel desde la raíz: las funciones de api/.
  // La app tiene su propio tsconfig en apps/web.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    // Como corre en Vercel (Node con ESM): un import relativo sin ".js" falla al cargar la función
    // (FUNCTION_INVOCATION_FAILED). Con nodenext, tsc lo marca como error antes de publicar.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api"]
}
