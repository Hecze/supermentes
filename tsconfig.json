{
  // Solo para lo que corre en Vercel desde la raíz: las funciones de api/ y middleware.ts.
  // La app tiene su propio tsconfig en apps/web.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api", "middleware.ts"]
}
