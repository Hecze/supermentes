{
  "name": "supermentes",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "verificar:curriculo": "npm run verificar:curriculo -w @supermentes/web",
    "test": "node --test --import ./tests/cargar-ts.mjs tests/*.test.ts apps/web/src/sesion/*.test.ts",
    "db:postgres": "node scripts/postgres.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@clerk/backend": "^3.25.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "zod": "^4.6.7"
  }
}
