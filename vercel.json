{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "turbo run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/j/:codigo",
      "destination": "/j/index.html"
    },
    {
      "source": "/t/:codigo",
      "destination": "/j/index.html"
    }
  ]
}
