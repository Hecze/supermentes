{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "turbo run build",
  "outputDirectory": "apps/web/dist",
  "ignoreCommand": "sh scripts/vercel-saltar.sh",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:ruta(entrar-demo|intentos|mis-envios|perfil|preferencias-sesion|salones|tareas)",
      "destination": "/api/cuentas?ruta=:ruta"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:paso+",
      "destination": "/app/index.html"
    },
    {
      "source": "/j/:codigo",
      "destination": "/j/index.html"
    },
    {
      "source": "/t/:codigo",
      "destination": "/j/index.html"
    }
  ]
}
