# Variables de Supermentes. Copia lo que necesites:
#   - dev con Vite (npm run dev):        .env.local en la raíz
#   - Worker local (npx wrangler dev):   .dev.vars en la raíz
#   - producción (Cloudflare):           secretos con `npx wrangler secret put NOMBRE`
# Las VITE_* van al navegador y se fijan al compilar: son públicas (.env y .env.production ya están en el repo).

# --- Navegador (build) ---
# "real" usa el backend; sin ella la app muestra datos de ejemplo. Producción: .env.production.
VITE_API=real
# Clave pública de Clerk (pk_test_… en desarrollo, pk_live_… en producción). Sin ella no hay cuentas. Va en .env.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Servidor (api/) ---
# IA (Claude) por OpenRouter: ficha, juego, canción, examen y sesión. Obligatoria.
OPENROUTER_API_KEY=sk-or-v1-xxx
# Opcionales: modelo de texto y de música (por defecto anthropic/claude-opus-5.5 y google/lyria-3-clip-preview).
AI_MODEL=
MUSIC_MODEL=
# Videos y fichas del tema (exa.ai). Sin ella, la sección no aparece.
EXA_API_KEY=xxx
# Verifica la cuenta de la docente en /api/mis-envios (sk_test_… / sk_live_…).
CLERK_SECRET_KEY=sk_test_xxx
# Clave para bajar la lista de espera en CSV o borrar un registro (/api/lista-espera?clave=…).
LISTA_CLAVE=xxx

# --- Almacenamiento ---
# En Cloudflare los archivos van a R2 (binding BLOB en wrangler.jsonc): no hace falta variable.
# Solo para `npm run dev` con datos reales de Vercel Blob; sin ella usa un Blob en memoria.
BLOB_READ_WRITE_TOKEN=
