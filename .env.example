# Variables de Supermentes. Copia lo que necesites:
#   - dev con Vite (npm run dev):        .env.local en la raíz
#   - producción (Vercel):               Settings → Environment Variables del proyecto supermentes
# Las VITE_* van al navegador y se fijan al compilar: son públicas (.env y .env.production ya están en el repo).

# --- Navegador (build) ---
# "real" usa el backend; sin ella la app muestra datos de ejemplo. Producción: .env.production.
VITE_API=real
# Clave pública de Clerk (pk_test_… en desarrollo, pk_live_… en producción). Sin ella no hay cuentas. Va en .env.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Servidor (api/) ---
# IA (Claude) por OpenRouter: ficha, juego, examen y sesión. Obligatoria.
OPENROUTER_API_KEY=sk-or-v1-xxx
# Opcional: modelo de texto (por defecto anthropic/claude-opus-5.5).
AI_MODEL=
# Videos y fichas del tema (exa.ai). Sin ella, la sección no aparece.
EXA_API_KEY=xxx
# Verifica la cuenta de la docente (perfil, salones, tareas, envíos): sk_test_… / sk_live_….
CLERK_SECRET_KEY=sk_test_xxx
# Opcional: Atomic Memory (https://docs.atomicstrata.ai) para recordar, si la docente lo pide, la duración y el
# enfoque de sus próximas sesiones. Sin las dos, está apagado y la app no muestra nada. Solo en el servidor.
ATOMICMEMORY_API_URL=https://api.atomicstrata.ai
ATOMICMEMORY_API_KEY=amc_xxx
# Clave para bajar la lista de espera en CSV o borrar un registro (/api/lista-espera?clave=…).
LISTA_CLAVE=xxx

# --- Almacenamiento ---
# Postgres (Neon): cuentas, salones, tareas, intentos y envíos. Obligatoria en Vercel; las tablas se crean con
# `npm run db:postgres`.
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
# Juegos compartidos, resultados y lista de espera: Vercel Blob. Obligatoria en Vercel; en `npm run dev`, sin
# ella usa un Blob en memoria.
BLOB_READ_WRITE_TOKEN=
