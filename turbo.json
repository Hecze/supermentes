{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["VITE_*"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/presentacion/**"], "outputs": ["dist/**", "dist-preview/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "dev": { "cache": false, "persistent": true }
  }
}
